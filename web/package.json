		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"ws": "^8.22.1"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"bits-ui": "^2.20.6",
		"fast-average-color": "^9.6.0",
		"svelte-dnd-action": "^0.9.80"
	}
